# Wrike MCP Server configuration.
# Copy to .env and fill in. NEVER commit .env or data/.

# --- Server ---
# Bind address. Use 0.0.0.0 only behind a reverse proxy/TLS terminator.
PORT=3000
HOST=127.0.0.1

# --- Authentication ---
# "pat" (permanent access token) or "oauth" (OAuth 2.0 authorization code flow).
# If omitted, auto-detected: WRIKE_PAT set -> pat, OAuth vars set -> oauth.
# AUTH_MODE=oauth

# PAT mode
# WRIKE_PAT=your-permanent-token
# WRIKE_HOST=www.wrike.com

# OAuth mode (Client ID / Secret from https://www.wrike.com/appconsole.htm?#/api)
# WRIKE_CLIENT_ID=your-client-id
# WRIKE_CLIENT_SECRET=your-client-secret
# WRIKE_REDIRECT_URI=https://your-host/oauth/callback
# Comma-delimited scopes, e.g. Default,wsReadWrite
# WRIKE_SCOPES=Default,wsReadWrite

# --- Secret storage ---
# 32-byte key as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts the on-disk token store (AES-256-GCM). NEVER commit or expose.
# TOKEN_ENCRYPTION_KEY=

# Where the encrypted token store is written.
# TOKEN_STORE_PATH=data/tokens.json

# --- MCP-native sign-in (optional, oauth mode) ---
# Public origin of this server as MCP clients see it. Enables OAuth discovery
# (/.well-known/*) and /oauth/* endpoints so clients like Claude can sign in
# natively instead of pasting a Bearer token. Include any path prefix when
# routed behind a shared proxy, e.g. https://host/wrike
# PUBLIC_BASE_URL=